# Normaliza finales de linea para que Mac y Windows no peleen.
# Sin esto, Git en Windows reescribe todos los .cs y .meta al hacer checkout
# y aparecen como modificados aunque nadie los haya tocado.
* text=auto eol=lf

# Archivos de texto del proyecto. Se declaran explicitamente para que Git
# nunca los trate como binarios por error.
*.cs             text eol=lf diff=csharp
*.meta           text eol=lf
*.unity          text eol=lf
*.prefab         text eol=lf
*.asset          text eol=lf
*.mat            text eol=lf
*.anim           text eol=lf
*.controller     text eol=lf
*.shader         text eol=lf
*.cginc          text eol=lf
*.hlsl           text eol=lf
*.inputactions   text eol=lf
*.json           text eol=lf
*.md             text eol=lf

# Binarios: que Git nunca intente convertirlos ni diffearlos.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.fbx  binary
*.dll  binary
*.unitypackage binary
